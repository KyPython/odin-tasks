{
  "name": "harbor-workspace",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "build:service": "node scripts/clean.mjs && turbo run build --filter=@harbor/dispatch-service",
    "check:container": "node scripts/check-container-target.mjs",
    "check:unrelated": "pnpm --filter @harbor/status-check test"
  },
  "devDependencies": {
    "turbo": "2.3.3"
  }
}
